extends RefCounted
## Thư viện hình có chủ đích cho level từ DifficultyCurve.MOTIF_FROM (design.md mục 4): mỗi hình vẽ tay vài cỡ, nhỏ tới
## lớn (khoảng 36 tới 182 ô). '.' là ô trống; mọi ký tự khác là ô thuộc hình và là tên vùng của ô đó (dải, vòng, cánh hoa,
## giấy gói...): kiểu cắt "template" chỉ gộp ô cùng vùng. Mọi bản vẽ rộng chẵn để nằm đúng giữa bàn 14 cột, tối đa 12×17,
## và đối xứng trái phải hoặc trên dưới (hoặc cả hai), vùng cũng đối xứng theo trục đó; bộ sinh cắt khối theo đúng các trục
## đối xứng của bản vẽ. Thuần dữ liệu và xác định.

## Thứ tự xen kẽ ba nhóm (hình cơ bản, theme kẹo, hình khác) để các level liền nhau ra hình khác nhóm.
const KINDS := [
	"arrow", "heart", "flower", "candy", "star", "house", "chocolate", "cross", "lollipop", "butterfly", "saltire",
	"gift", "cupcake", "tree", "jar", "diamond", "icecream", "crown", "cake", "hourglass", "donut", "mushroom",
	"popsicle", "arrow_side", "rocket", "clover", "macaron",
]

static var _cache: Dictionary = {}  # kind -> Array[Dictionary]


## Các biến thể của hình `kind` (mỗi cỡ, thêm bản lật trong `flips`):
## {kind, w, h, cells: Array[Vector2i], regions: Dictionary (ô -> tên vùng), sym_h, sym_v}.
## `sym_h`: đối xứng trái phải, `sym_v`: đối xứng trên dưới. Kết quả dùng chung qua cache: bên gọi không được sửa.
static func variants(kind: String) -> Array:
	if not _cache.has(kind):
		var out: Array = []
		var spec: Dictionary = MOTIFS[kind]
		for rows in spec["sizes"]:
			out.append(_variant(kind, rows, ""))
			for f in spec["flips"]:
				out.append(_variant(kind, rows, f))
		_cache[kind] = out
	return _cache[kind]


static func _variant(kind: String, rows: Array, flip: String) -> Dictionary:
	var h := rows.size()
	var w := str(rows[0]).length()
	var filled := {}
	var cells: Array[Vector2i] = []
	for y in h:
		var row := str(rows[h - 1 - y if flip == "v" else y])
		for x in w:
			var ch := row[w - 1 - x if flip == "h" else x]
			if ch != ".":
				var c := Vector2i(x, y)
				cells.append(c)
				filled[c] = ch
	var sym_h := true
	var sym_v := true
	for c in cells:
		sym_h = sym_h and filled.has(Vector2i(w - 1 - c.x, c.y))
		sym_v = sym_v and filled.has(Vector2i(c.x, h - 1 - c.y))
	return {"kind": kind, "w": w, "h": h, "cells": cells, "regions": filled, "sym_h": sym_h, "sym_v": sym_v}


