[sub_resource type="Shader" id="Shader_0grxe"]
code = "shader_type canvas_item;
// UV.y where the rail stops, just behind the top edge of the Play button (set by home.gd).
uniform float cut = 1.0;
void fragment() {
	COLOR.a *= smoothstep(0.0, 0.05, UV.y) * step(UV.y, cut);
}
"

